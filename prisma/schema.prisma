// prisma/schema.prisma
// Sam'Aila — Full database schema
// Database: PostgreSQL (Digital Ocean Ubuntu droplet)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────────
// HOMEPAGE
// ─────────────────────────────────────────────

model HeroSlide {
  id            String   @id @default(cuid())
  imagePublicId String
  imageSrc      String
  imageAlt      String   @default("")
  imagePosition String   @default("center")
  headline      String?
  subheadline   String?
  ctaLabel      String   @default("")
  ctaHref       String   @default("/ready-to-wear")
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("hero_slides")
}

model HomeFeatureLink {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  href          String
  imagePublicId String
  imageSrc      String
  imageAlt      String   @default("")
  imagePosition String   @default("center")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("home_feature_links")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  sku              String           @unique
  categorySlug     String
  tier             ProductTier      @default(READY_TO_WEAR)
  description      String?          @db.Text
  material         String?
  careInstructions String?          @db.Text
  priceKobo        Int              // selling price in kobo
  comparePriceKobo Int?             // original price (if discounted)
  tags             String[]
  available        Boolean          @default(true)
  featured         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]

  @@index([categorySlug])
  @@index([available])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id            String  @id @default(cuid())
  productId     String
  imagePublicId String
  src           String
  alt           String  @default("")
  imagePosition String  @default("center")
  order         Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  size        String?
  color       String?
  sku         String?
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

enum ProductTier {
  READY_TO_WEAR
  BESPOKE
  MADE_TO_ORDER
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?
  customerName     String
  customerEmail    String
  customerPhone    String?
  shippingAddress  Json?
  itemCount        Int           @default(0)
  subtotal         Int           // in kobo
  shippingCost     Int           @default(0)
  total            Int           // in kobo
  notes            String?       @db.Text
  fulfilledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            OrderItem[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Int      // in kobo
  subtotal    Int      // in kobo
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// LOOKBOOKS
// ─────────────────────────────────────────────

model Lookbook {
  id                 String               @id @default(cuid())
  slug               String               @unique
  title              String
  subtitle           String?
  season             String?
  description        String?              @db.Text
  isPublished        Boolean              @default(false)
  order              Int                  @default(0)
  coverImagePublicId String?
  coverImageSrc      String?
  coverImageAlt      String               @default("")
  heroImagePublicId  String?
  heroImageSrc       String?
  heroImageAlt       String               @default("")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  looks              LookbookLook[]
  gallery            LookbookGalleryImage[]

  @@index([isPublished])
  @@map("lookbooks")
}

model LookbookLook {
  id            String   @id @default(cuid())
  lookbookId    String
  lookNumber    String?
  title         String?
  category      String?
  description   String?  @db.Text
  imagePublicId String
  imageSrc      String
  imageAlt      String   @default("")
  imagePosition String   @default("center")
  order         Int      @default(0)
  lookbook      Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)

  @@index([lookbookId])
  @@map("lookbook_looks")
}

model LookbookGalleryImage {
  id            String   @id @default(cuid())
  lookbookId    String
  imagePublicId String
  imageSrc      String
  imageAlt      String   @default("")
  imagePosition String   @default("center")
  order         Int      @default(0)
  lookbook      Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)

  @@index([lookbookId])
  @@map("lookbook_gallery_images")
}

// ─────────────────────────────────────────────
// JOURNAL
// ─────────────────────────────────────────────

model JournalArticle {
  id                String              @id @default(cuid())
  slug              String              @unique
  title             String
  subtitle          String?
  category          String?
  author            String?
  excerpt           String?             @db.Text
  published         Boolean             @default(false)
  publishedAt       DateTime?
  coverImagePublicId String?
  coverImageSrc     String?
  coverImageAlt     String              @default("")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  blocks            JournalBlock[]
  gallery           JournalGalleryImage[]

  @@index([published])
  @@map("journal_articles")
}

model JournalBlock {
  id            String           @id @default(cuid())
  articleId     String
  type          JournalBlockType
  content       String?          @db.Text
  imagePublicId String?
  imageSrc      String?
  imageAlt      String?
  order         Int              @default(0)
  article       JournalArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("journal_blocks")
}

model JournalGalleryImage {
  id            String         @id @default(cuid())
  articleId     String
  imagePublicId String
  imageSrc      String
  imageAlt      String         @default("")
  order         Int            @default(0)
  article       JournalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("journal_gallery_images")
}

enum JournalBlockType {
  PARAGRAPH
  HEADING
  QUOTE
  IMAGE
  DIVIDER
}

// ─────────────────────────────────────────────
// THE HOUSE PAGE
// ─────────────────────────────────────────────

model HouseContent {
  id                String         @id @default(cuid())
  heroTitle         String         @default("The House")
  heroSubtitle      String?
  heroImagePublicId String?
  heroImageSrc      String?
  heroImageAlt      String         @default("")
  overviewTitle     String?
  overviewBody      String?        @db.Text
  updatedAt         DateTime       @updatedAt
  sections          HouseSection[]

  @@map("house_content")
}

model HouseSection {
  id            String       @id @default(cuid())
  contentId     String
  title         String
  subtitle      String?
  body          String       @db.Text
  imagePublicId String?
  imageSrc      String?
  imageAlt      String?
  imagePosition String       @default("center")
  order         Int          @default(0)
  content       HouseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("house_sections")
}

// ─────────────────────────────────────────────
// CRAFT & LEGACY PAGE
// ─────────────────────────────────────────────

model CraftContent {
  id                String               @id @default(cuid())
  heroTitle         String               @default("Craft & Legacy")
  heroSubtitle      String?
  heroImagePublicId String?
  heroImageSrc      String?
  heroImageAlt      String               @default("")
  introHeading      String?
  introBody         String?              @db.Text
  principlesHeading String?
  updatedAt         DateTime             @updatedAt
  editorialImages   CraftEditorialImage[]
  principles        CraftPrinciple[]

  @@map("craft_content")
}

model CraftEditorialImage {
  id            String       @id @default(cuid())
  contentId     String
  imagePublicId String
  imageSrc      String
  imageAlt      String       @default("")
  caption       String?
  order         Int          @default(0)
  content       CraftContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("craft_editorial_images")
}

model CraftPrinciple {
  id        String       @id @default(cuid())
  contentId String
  title     String
  body      String       @db.Text
  order     Int          @default(0)
  content   CraftContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("craft_principles")
}

// ─────────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  clientName  String
  clientEmail String
  clientPhone String?
  type        AppointmentType
  scheduledAt DateTime?
  message     String?           @db.Text
  adminNotes  String?           @db.Text
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@map("appointments")
}

enum AppointmentType {
  BESPOKE_FITTING
  COLLECTION_PREVIEW
  PERSONALISATION
  GENERAL_ENQUIRY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────

model SiteSettings {
  id                  String  @id @default(cuid())
  siteName            String  @default("Sam'Aila")
  siteTagline         String?
  siteDescription     String? @db.Text
  contactEmail        String?
  contactPhone        String?
  instagramUrl        String?
  twitterUrl          String?
  facebookUrl         String?
  maintenanceMode     Boolean @default(false)
  maintenanceMessage  String?
  appointmentsEnabled Boolean @default(true)
  ordersEnabled       Boolean @default(true)
  logoPublicId        String?
  logoSrc             String?
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}
